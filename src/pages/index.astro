---
import Layout from "@/layouts/Layout.astro";
---

<Layout>
  <canvas id="cockpit"></canvas>
</Layout>

<script>
  import { start } from "@/game/game";

  const canvas = document.getElementById("cockpit");
  if (canvas instanceof HTMLCanvasElement) start(canvas);
</script>

<style>
  canvas {
    display: block;
    width: 100vw;
    height: 100vh;
  }
</style>
